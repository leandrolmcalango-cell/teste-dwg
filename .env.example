# Token pessoal do ClickUp, obtido em Settings > Apps > API Token
CLICKUP_API_TOKEN=pk_coloque_seu_token_aqui > 

# Chave da AutoDWG API
AUTODWG_API_KEY=coloque_sua_chave_autodwg_aqui #adg_2964911821269382e4bb3394f8b9e79d <- chave api DWG

# Chave criada por você para proteger o endpoint público
WEBHOOK_SECRET=crie_uma_chave_longa_e_aleatoria  # DWG-REp8QCF2wHZxO_hPK-JfDpsQ65j6NJzMc7GyuYpr9IA <-- possível chave 


# Opcional
AUTODWG_API_BASE=https://www.autodwg.com/api
MAX_FILE_MB=5
POLL_INTERVAL_SECONDS=3
MAX_POLL_ATTEMPTS=40
LOG_LEVEL=INFO
